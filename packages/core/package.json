{
  "name": "@hodor/core",
  "version": "0.5.0-dev",
  "description": "Hodor core business logic and Kubernetes operations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "port-forward",
    "kubectl"
  ],
  "author": "Davide Maggi <davide.maggi@live.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@kubernetes/client-node": "^0.20.0",
    "@napi-rs/keyring": "^2.1.2",
    "i18next": "^23.7.6",
    "yaml": "^2.9.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@vitest/coverage-v8": "^0.34.6",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6"
  }
}
