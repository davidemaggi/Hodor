{
  "name": "@hodor/gui",
  "version": "1.0.0-rc.4",
  "private": true,
  "description": "Hodor desktop app",
  "desktopName": "hodor-app.desktop",
  "author": "Davide Maggi <davide.maggi@live.com>",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "preview:web": "vite --config vite.fixtures.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf out",
    "dist": "pnpm --filter @hodor/cli bundle && pnpm build && electron-builder --publish never",
    "dist:dir": "pnpm --filter @hodor/cli bundle && pnpm build && electron-builder --dir",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hodor/core": "workspace:*",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^20.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "26",
    "electron-vite": "^6.0.0",
    "i18next": "^26.5.5",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.2",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.2.2",
    "vite": "^8.3.5",
    "vitest": "^0.34.6",
    "zod": "^3.22.4"
  },
  "homepage": "https://github.com/davidemaggi/Hodor",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidemaggi/Hodor.git"
  }
}
